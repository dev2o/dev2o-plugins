{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": "AGENT_CONDUCTOR_PLUGIN_ROOT=plugins/agent-conductor .cursor/hooks/agent-conductor-hook.sh hooks/transcriptor/shell-secrets-deny.sh",
        "timeout": 30
      },
      {
        "command": "AGENT_CONDUCTOR_PLUGIN_ROOT=plugins/agent-conductor .cursor/hooks/agent-conductor-hook.sh hooks/transcriptor/audit.sh",
        "timeout": 30
      }
    ],
    "afterShellExecution": [
      {
        "command": "AGENT_CONDUCTOR_PLUGIN_ROOT=plugins/agent-conductor .cursor/hooks/agent-conductor-hook.sh hooks/transcriptor/audit.sh",
        "timeout": 30
      }
    ],
    "beforeReadFile": [
      {
        "command": "AGENT_CONDUCTOR_PLUGIN_ROOT=plugins/agent-conductor .cursor/hooks/agent-conductor-hook.sh hooks/transcriptor/audit.sh",
        "timeout": 30
      }
    ],
    "afterFileEdit": [
      {
        "command": "AGENT_CONDUCTOR_PLUGIN_ROOT=plugins/agent-conductor .cursor/hooks/agent-conductor-hook.sh hooks/transcriptor/audit.sh",
        "timeout": 30
      }
    ],
    "preToolUse": [
      {
        "command": "AGENT_CONDUCTOR_PLUGIN_ROOT=plugins/agent-conductor .cursor/hooks/agent-conductor-hook.sh hooks/context-injector/subagent-context-pre-tool-use.sh",
        "matcher": "Task",
        "timeout": 30
      },
      {
        "command": "AGENT_CONDUCTOR_PLUGIN_ROOT=plugins/agent-conductor .cursor/hooks/agent-conductor-hook.sh hooks/transcriptor/audit.sh",
        "matcher": "Grep|Delete|Task|MCP",
        "timeout": 30
      }
    ],
    "postToolUse": [
      {
        "command": "AGENT_CONDUCTOR_PLUGIN_ROOT=plugins/agent-conductor .cursor/hooks/agent-conductor-hook.sh hooks/transcriptor/audit.sh",
        "matcher": "Grep|Delete",
        "timeout": 30
      }
    ],
    "postToolUseFailure": [
      {
        "command": "AGENT_CONDUCTOR_PLUGIN_ROOT=plugins/agent-conductor .cursor/hooks/agent-conductor-hook.sh hooks/transcriptor/audit.sh",
        "matcher": "Grep|Delete",
        "timeout": 30
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "AGENT_CONDUCTOR_PLUGIN_ROOT=plugins/agent-conductor .cursor/hooks/agent-conductor-hook.sh hooks/context-injector/main-agent-orchestrator-inject.sh",
        "timeout": 30
      },
      {
        "command": "AGENT_CONDUCTOR_PLUGIN_ROOT=plugins/agent-conductor .cursor/hooks/agent-conductor-hook.sh hooks/transcriptor/audit.sh",
        "timeout": 30
      }
    ],
    "preCompact": [
      {
        "command": "AGENT_CONDUCTOR_PLUGIN_ROOT=plugins/agent-conductor .cursor/hooks/agent-conductor-hook.sh hooks/transcriptor/audit.sh",
        "timeout": 30
      }
    ],
    "afterAgentResponse": [
      {
        "command": "AGENT_CONDUCTOR_PLUGIN_ROOT=plugins/agent-conductor .cursor/hooks/agent-conductor-hook.sh hooks/transcriptor/audit.sh",
        "timeout": 30
      }
    ],
    "afterAgentThought": [
      {
        "command": "AGENT_CONDUCTOR_PLUGIN_ROOT=plugins/agent-conductor .cursor/hooks/agent-conductor-hook.sh hooks/transcriptor/audit.sh",
        "timeout": 30
      }
    ],
    "subagentStop": [
      {
        "command": "AGENT_CONDUCTOR_PLUGIN_ROOT=plugins/agent-conductor .cursor/hooks/agent-conductor-hook.sh hooks/transcriptor/audit.sh",
        "timeout": 30
      }
    ]
  }
}
